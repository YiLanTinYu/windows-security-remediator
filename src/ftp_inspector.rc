#pragma code_page(65001)
#include <windows.h>
#include "version.h"

1 ICON "remediator.ico"

1 VERSIONINFO
 FILEVERSION SR_FTP_INSPECTOR_VERSION_COMMA
 PRODUCTVERSION SR_FTP_INSPECTOR_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo" BEGIN
    BLOCK "080404b0" BEGIN
      VALUE "CompanyName", "倚栏听雨\0"
      VALUE "FileDescription", "终端安全静默检查修复与 FTP 报告回传工具\0"
      VALUE "FileVersion", SR_FTP_INSPECTOR_VERSION_STRING
      VALUE "InternalName", "FtpCheckRepair\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 倚栏听雨\0"
      VALUE "OriginalFilename", "ftp-check-repair.exe\0"
      VALUE "ProductName", "终端安全 FTP 检查修复回传工具\0"
      VALUE "ProductVersion", SR_FTP_INSPECTOR_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo" BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END

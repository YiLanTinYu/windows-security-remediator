#pragma code_page(65001)
#include <windows.h>
#include "version.h"

1 ICON "remediator.ico"

1 VERSIONINFO
 FILEVERSION SR_REPORT_SERVER_VERSION_COMMA
 PRODUCTVERSION SR_REPORT_SERVER_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo" BEGIN
    BLOCK "080404b0" BEGIN
      VALUE "CompanyName", "倚栏听雨\0"
      VALUE "FileDescription", "终端安全检查报告接收与管理服务\0"
      VALUE "FileVersion", SR_REPORT_SERVER_VERSION_STRING
      VALUE "InternalName", "SecurityInspectionReportServer\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 倚栏听雨\0"
      VALUE "OriginalFilename", "检查报告服务端.exe\0"
      VALUE "ProductName", "终端安全检查与报告系统\0"
      VALUE "ProductVersion", SR_REPORT_SERVER_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo" BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END

#pragma code_page(65001)
#include <windows.h>
#include "version.h"

1 ICON "remediator.ico"

1 VERSIONINFO
 FILEVERSION SR_ONSITE_INSPECTOR_VERSION_COMMA
 PRODUCTVERSION SR_ONSITE_INSPECTOR_VERSION_COMMA
 FILEFLAGSMASK 0x3fL
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo" BEGIN
    BLOCK "080404b0" BEGIN
      VALUE "CompanyName", "倚栏听雨\0"
      VALUE "FileDescription", "Windows 现场安全检查与修复工具\0"
      VALUE "FileVersion", SR_ONSITE_INSPECTOR_VERSION_STRING
      VALUE "InternalName", "OnsiteCheckRepair\0"
      VALUE "LegalCopyright", "Copyright (C) 2026 倚栏听雨\0"
      VALUE "OriginalFilename", "onsite-check-repair.exe\0"
      VALUE "ProductName", "终端安全现场检查修复工具\0"
      VALUE "ProductVersion", SR_ONSITE_INSPECTOR_VERSION_STRING
    END
  END
  BLOCK "VarFileInfo" BEGIN
    VALUE "Translation", 0x0804, 1200
  END
END
